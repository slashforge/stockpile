{
  "name": "stockpile",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "api:dev": "bun --env-file=.env --watch apps/api/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "stories:ingest": "bun --env-file=.env apps/api/scripts/ingest-stories.ts",
    "stories:recontext": "bun --env-file=.env apps/api/scripts/recontext-stories.ts",
    "tokens:coverage": "bun --env-file=.env apps/api/scripts/check-tokens-coverage.ts",
    "prices:snapshot": "bun --env-file=.env apps/api/scripts/snapshot-prices.ts",
    "congress:ingest": "bun --env-file=.env apps/api/scripts/ingest-congress.ts",
    "generate:sdk": "bun run --cwd apps/api generate:openapi && bun run --cwd packages/api-client generate"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@types/bun": "latest",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7"
  },
  "peerDependencies": {
    "typescript": "5"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "sst": "^4.12.2"
  }
}
