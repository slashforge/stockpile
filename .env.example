DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5431/DATABASE
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
JUPITER_API_KEY=your-jupiter-api-key
HELIUS_API_KEY=your-helius-api-key
# Optional offline story curation. Never expose to mobile or public feed reads.
OPENAI_API_KEY=
STOCKPILE_AI_MODEL=gpt-4o-mini
# Trading allowlist: comma-separated SYMBOL:SolanaMint. A bag is tradable only when EVERY asset symbol is listed.
# Only add mints you have independently verified against the issuer directory (https://api.xstocks.fi/api/v2/public/assets,
# Solana deployment address) AND Jupiter Tokens V2 (exact id, symbol, decimals, "verified"/"xstocks" tags, live USDC route).
# The eight xStocks (8 decimals) and eight PreStocks (9 decimals, mints start with "Pre", verified via https://prestocks.com/api/prestocks
# plus Jupiter tags "verified"+"prestocks") below were verified on 2026-09-25. Re-verify before trusting on a new deployment.
# STOCKPILE_PRESTOCKS=0 disables the PreStocks directory (pre-IPO bags become research-only).
STOCKPILE_ALLOWED_MINTS=AAPLx:XsbEhLAtcf6HdfpFZ5xEMdqW8nfAvcsP5bdudRLJzJp,MSFTx:XspzcW1PRtgf6Wj92HCiZdjzKCyFekVD8P5Ueh3dRMX,NVDAx:Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh,AMDx:XsXcJ6GZ9kVnjqGsjBnktRcuwMBmvKWh8S93RefZ1rF,GOOGLx:XsCPL9dNWBMvFtTmwcCA5v3xWPSMEBCszbQdiLLq6aN,AMZNx:Xs3eBt7uRfJX8QUs4suhyU8p2M6DoUDrJyWBa8LLZsg,TSLAx:XsDoVfqeBukxuZHWhdvWHBhgEHjGNst4MLodqsJHzoB,NFLXx:XsEH7wWfJJu2ZT3UCFeVfALnVA6CP5ur7Ee11KmzVpL,OPENAI:PreweJYECqtQwBtpxHL171nL2K6umo692gTm7Q3rpgF,ANTHROPIC:Pren1FvFX6J3E4kXhJuCiAD5aDmGEb7qJRncwA8Lkhw,FIGUREAI:PreZad18qfPtbxNpMtMuAuX2zVpvkEU8DnJx56faCWd,NEURALINK:PrekqLJvJ3qVdXmBGDiexvwUTF4rLFDa6HWS4HJbw9S,KALSHI:PreLWGkkeqG1s4HEfFZSy9moCrJ7btsHuUtfcCeoRua,POLYMARKET:Pre8AREmFPtoJFT8mQSXQLh56cwJmM7CFDRuoGBZiUP,SPACEX:PreANxuXjsy2pvisWWMNB6YaJNzr7681wJJr2rHsfTh,ANDURIL:PresTj4Yc2bAR197Er7wz4UUKSfqt6FryBEdAriBoQB
# Optional market data keys. Pyth Hermes requires an API key since 2026-08-26 (https://docs.pyth.network); without it the
# xStocks underlying reference falls back to Jupiter's stock reference price. CongressInvests free tier (100 req/day) needs no key.
PYTH_API_KEY=
STOCKPILE_CONGRESS_API_KEY=
# tokens.xyz (https://api.tokens.xyz/v1) candles for /assets/{mint}/chart, /bags/{id}/chart, /bags/sparklines and /bags/{id}/history.
# Without it the chart endpoints return empty points with reason "unconfigured" and history falls back to the hourly price_snapshots
# table (source "snapshot"). Deployed stages use the TokensApiKey SST secret instead. Server-side only; never shipped to the client.
TOKENS_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:4321
PORT=4040
