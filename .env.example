DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5431/DATABASE
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
JUPITER_API_KEY=your-jupiter-api-key
HELIUS_API_KEY=your-helius-api-key
# Paymaster that pays every swap's network fee + token-account rent so users never need SOL (slippage stays theirs).
# Base58 secret key or solana-keygen JSON array of a dedicated, SOL-funded wallet. Server-side only. Deployed stages use the
# SolanaPaymasterKey SST secret. Without it /trade/prepare returns PROVIDER_NOT_CONFIGURED. Needs HELIUS_API_KEY (simulation).
SOLANA_PAYMASTER_KEY=
# Optional offline story curation. Never expose to mobile or public feed reads.
OPENAI_API_KEY=
STOCKPILE_AI_MODEL=gpt-4o-mini
# Tradable mints are not configured per token: they are resolved live from the issuer directories (xStocks
# https://api.xstocks.fi/api/v2/public/assets/{symbol}, PreStocks https://prestocks.com/api/prestocks) and must pass Jupiter
# verification (exact mint, symbol, decimals, "verified" + issuer tag, live USDC route). Previously verified mints are pinned
# in apps/api/src/lib/issuer-assets.ts; a directory reporting a different mint for a pinned symbol is refused.
# Emergency switch: comma-separated mints or symbols to stop trading immediately (e.g. KALSHI,XsbEhL...). Empty = none.
STOCKPILE_BLOCKED_MINTS=
# STOCKPILE_XSTOCKS=0 / STOCKPILE_PRESTOCKS=0 disable an issuer directory (its bags become research-only).
# Optional market data keys. Pyth Hermes requires an API key since 2026-08-26 (https://docs.pyth.network); without it the
# xStocks underlying reference falls back to Jupiter's stock reference price. CongressInvests free tier (100 req/day) needs no key.
PYTH_API_KEY=
STOCKPILE_CONGRESS_API_KEY=
# tokens.xyz (https://api.tokens.xyz/v1) candles for /assets/{mint}/chart, /bags/{id}/chart, /bags/sparklines and /bags/{id}/history.
# Without it the chart endpoints return empty points with reason "unconfigured" and history falls back to the hourly price_snapshots
# table (source "snapshot"). Deployed stages use the TokensApiKey SST secret instead. Server-side only; never shipped to the client.
TOKENS_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:4321
PORT=4040
