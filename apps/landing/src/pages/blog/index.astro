---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description="Latest updates, insights, and news from the Stockpile team." />
	</head>
	<body class="bg-background text-text antialiased">
		<Nav />
		<main class="pt-24 pb-16 px-6">
			<div class="max-w-5xl mx-auto">
				<div class="text-center mb-16">
					<span class="badge badge-brand mb-4">Blog</span>
					<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-text">
						Latest Updates
					</h1>
					<p class="text-text-subtle text-lg max-w-xl mx-auto">
						Insights, tutorials, and news from the Stockpile team.
					</p>
				</div>

				<div class="grid md:grid-cols-2 gap-6">
					{posts.map((post, index) => (
						<a 
							href={`/blog/${post.id}/`}
							class:list={[
								"card group block overflow-hidden",
								index === 0 && "md:col-span-2"
							]}
						>
							{post.data.heroImage && (
								<div class="relative overflow-hidden rounded-xl mb-4">
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										width={index === 0 ? 1020 : 720}
										height={index === 0 ? 510 : 360}
										class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
										loading="lazy"
									/>
								</div>
							)}
							<div class="space-y-2">
								<div class="flex items-center gap-3 text-sm text-text-muted">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2 class:list={[
									"font-semibold text-text group-hover:text-brand transition-colors duration-200",
									index === 0 ? "text-2xl md:text-3xl" : "text-xl"
								]}>
									{post.data.title}
								</h2>
								{post.data.description && (
									<p class="text-text-subtle line-clamp-2">{post.data.description}</p>
								)}
							</div>
						</a>
					))}
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
