---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/home/Hero.astro";
import Tape from "../components/home/Tape.astro";
import FrontPage from "../components/home/FrontPage.astro";
import Tour from "../components/home/Tour.astro";
import BagDesk from "../components/home/BagDesk.astro";
import FinePrint from "../components/home/FinePrint.astro";
import Faq from "../components/home/Faq.astro";
import Closing from "../components/home/Closing.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { loadBagCatalogue, uniqueAssets } from "../lib/bags";
import { loadStories } from "../lib/stories";
import "../styles/home.css";

const catalogue = await loadBagCatalogue();
const { stories, source: storySource } = await loadStories(catalogue.bags);
const tokenCount = uniqueAssets(catalogue.bags).length;
const closingAssets = uniqueAssets(catalogue.bags.filter((bag) => bag.sourceType === "editorial")).slice(0, 6);
// /screens/feed.webp shows a story pinned to this bag.
const featureBag = catalogue.bags.find((bag) => bag.id === "consumer-frontiers");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${SITE_TITLE} — Swipe the news. Buy the bag.`} description={SITE_DESCRIPTION} />
  </head>
  <body class="landing-home text-text antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <Hero bagCount={catalogue.bags.length} tokenCount={tokenCount} featureBag={featureBag} />
      <Tape bags={catalogue.bags} />
      <FrontPage stories={stories} bags={catalogue.bags} live={storySource === "live"} />
      <Tour />
      <BagDesk bags={catalogue.bags} tokenCount={tokenCount} live={catalogue.source === "live"} />
      <FinePrint />
      <Faq />
      <Closing assets={closingAssets} />
    </main>
    <Footer />

    <script>
      const targets = document.querySelectorAll("[data-reveal]");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
