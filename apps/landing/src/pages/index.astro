---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { APP_URL, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { loadBagCatalogue, formatWeight, monogram } from "../lib/bags";
import "../styles/home.css";

const catalogue = await loadBagCatalogue();
const featured = ["ai-infrastructure", "consumer-frontiers", "megacap-builders"]
  .map((id) => catalogue.bags.find((bag) => bag.id === id))
  .filter((bag): bag is NonNullable<typeof bag> => Boolean(bag));
const preview = featured[0] ?? catalogue.bags[0];
const faqs = [
  [
    "What is a bag?",
    "A bag is a themed basket of tokens with a defined allocation. You can inspect its holdings, weights, sources, and risks before deciding whether to buy. A bag is not an ETF or a managed fund.",
  ],
  [
    "Am I buying actual shares?",
    "You are buying tokens, not shares directly through a stockbroker. Tokenized stocks and pre-IPO tokens have issuer-specific structures, rights, and restrictions. Read the issuer documentation and Newsbid disclosures to understand what each token represents.",
  ],
  [
    "How do news stories connect to bags?",
    "Newsbid links stories to relevant bags and explains the connection, including evidence, uncertainty, and what to watch. AI-assisted interpretations are not predictions or investment advice. You can always open the original source.",
  ],
  [
    "Who controls my wallet?",
    "Your wallet is secured by Privy. You review and authorize transactions; Newsbid does not make investment decisions or buy on your behalf. Swaps are routed through Jupiter on Solana.",
  ],
  [
    "What should I know before buying?",
    "You can lose your entire investment. Liquidity, token prices, issuer restrictions, and availability can change. Pre-IPO tokens carry additional risks, and congressional disclosures are delayed reports, not real-time trades. Review all relevant disclosures before trading.",
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${SITE_TITLE} — Follow the story. Explore the trade.`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body class="landing-home">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <section class="home-hero home-container">
        <div class="hero-copy">
          <p class="home-kicker">
            <span class="status-dot"></span> News. Context. Conviction.
          </p>
          <h1>
            Follow the story.
            <br />
            Find your <span>next move.</span>
          </h1>
          <p class="hero-description">
            The news moves fast. See what it means for the companies behind it,
            explore themed baskets of tokens, and decide what comes next.
          </p>
          <div class="home-actions">
            <a class="home-button" href={APP_URL}>
              Explore Newsbid <span aria-hidden="true">↗</span>
            </a>
            <a class="home-text-link" href="#how">
              See how it works <span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="hero-note">
            Tokenized stocks &amp; pre-IPO tokens. On Solana.
          </p>
        </div>

        <div
          class="product-scene"
          aria-label="Illustrative Newsbid story and bag preview"
        >
          <div class="scene-topline">
            <span>THE SIGNAL, NOT THE NOISE</span>
            <span>01 / NEWSBID</span>
          </div>
          <div class="story-preview">
            <div class="preview-toolbar">
              <span class="preview-brand">
                <img src="/favicon.svg" width="22" height="22" alt="" /> Newsbid
              </span>
              <span class="preview-tab">Your daily perspective</span>
              <span class="preview-avatar">N</span>
            </div>
            <div class="story-art" aria-hidden="true">
              <div class="art-grid"></div>
              <div class="chip chip-one"></div>
              <div class="chip chip-two"></div>
              <div class="chip chip-three"></div>
              <span class="art-label">THE NEXT COMPUTE ERA</span>
              <span class="art-index">NB / 001</span>
            </div>
            <div class="story-preview-body">
              <div class="story-meta">
                <span>TECHNOLOGY</span>
                <span>Illustrative story</span>
              </div>
              <h2>The AI race is also an infrastructure story.</h2>
              <p>
                Behind the models: chips, cloud platforms, and the companies
                building the next layer.
              </p>
              <div class="story-insight">
                <span class="insight-mark" aria-hidden="true">
                  ↳
                </span>
                <div>
                  <strong>Look beyond the headline</strong>
                  <span>Explore the businesses connected to the story.</span>
                </div>
              </div>
              {preview && (
                <a
                  class="linked-bag"
                  href={`${APP_URL}/bag/${encodeURIComponent(preview.id)}`}
                >
                  <span class="mini-bag-icon" aria-hidden="true">
                    ↗
                  </span>
                  <span>
                    <small>RELATED BAG</small>
                    <strong>{preview.title}</strong>
                  </span>
                  <span class="linked-bag-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              )}
            </div>
          </div>
          {preview && (
            <div class="allocation-preview">
              <div class="allocation-heading">
                <span class="status-dot"></span> Inside the bag{" "}
                <span>ALLOCATION</span>
              </div>
              {preview.assets.slice(0, 3).map((asset) => (
                <div class="allocation-row">
                  <span
                    class="asset-monogram"
                    style={`--asset-color: ${asset.brandColor ?? "#2563eb"}`}
                  >
                    {monogram(asset.symbol)}
                  </span>
                  <div>
                    <strong>{asset.symbol}</strong>
                    <span>{asset.name.replace(" xStock", "")}</span>
                  </div>
                  <strong>{formatWeight(asset.weightBps)}</strong>
                </div>
              ))}
              <a href={`${APP_URL}/bag/${encodeURIComponent(preview.id)}`}>
                See all holdings <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
          <p class="scene-caption">
            <span class="caption-line"></span> A little more context. A more
            informed decision.
          </p>
        </div>
      </section>

      <div class="home-foundation">
        <div class="home-container foundation-inner">
          <span>
            A clearer path from
            <br />
            <strong>headline to holdings.</strong>
          </span>
          <div>
            <span class="foundation-icon" aria-hidden="true">
              ↗
            </span>{" "}
            Source-linked stories
          </div>
          <div>
            <span class="foundation-icon" aria-hidden="true">
              ▦
            </span>{" "}
            Transparent allocations
          </div>
          <div>
            <span class="foundation-icon" aria-hidden="true">
              ◎
            </span>{" "}
            Your own wallet
          </div>
        </div>
      </div>

      <section id="how" class="home-section home-container">
        <div class="section-heading">
          <div>
            <p class="home-kicker">01 / THE IDEA</p>
            <h2>
              Less noise.
              <br />
              More perspective.
            </h2>
          </div>
          <p>
            A headline is only the beginning. Newsbid brings the story, the
            companies, and the context into one place.
          </p>
        </div>
        <div class="steps-grid">
          <article class="step">
            <div class="step-top">
              <span>01</span>
              <span aria-hidden="true">↘</span>
            </div>
            <div class="step-visual visual-news" aria-hidden="true">
              <span class="paper-line"></span>
              <span class="paper-line"></span>
              <span class="paper-line short"></span>
              <div class="source-label">
                <span class="status-dot"></span> Start with the source
              </div>
            </div>
            <h3>Catch the story.</h3>
            <p>
              Browse a swipeable feed of news and public disclosures. Open the
              original source whenever you want to go deeper.
            </p>
          </article>
          <article class="step">
            <div class="step-top">
              <span>02</span>
              <span aria-hidden="true">↘</span>
            </div>
            <div class="step-visual visual-connect" aria-hidden="true">
              <span>THE STORY</span>
              <i></i>
              <span class="connection-bag">
                THE BAG <b>↗</b>
              </span>
            </div>
            <h3>Connect the dots.</h3>
            <p>
              See related bags, the reasoning behind the connection, and the
              uncertainty. Inspect every holding and allocation.
            </p>
          </article>
          <article class="step">
            <div class="step-top">
              <span>03</span>
              <span aria-hidden="true">↗</span>
            </div>
            <div class="step-visual visual-review" aria-hidden="true">
              <div>
                <span>Review your trade</span>
                <b>You're in control</b>
              </div>
              <span class="review-check">✓</span>
            </div>
            <h3>Make your own move.</h3>
            <p>
              Choose your amount, review the individual swaps, and authorize the
              transaction from your wallet. The decision stays yours.
            </p>
          </article>
        </div>
      </section>

      <section id="bags" class="bags-section">
        <div class="home-container home-section">
          <div class="section-heading">
            <div>
              <p class="home-kicker">02 / EXPLORE THE THEMES</p>
              <h2>
                Big ideas.
                <br />
                Unpacked into bags.
              </h2>
            </div>
            <div>
              <p>
                From the infrastructure powering AI to the platforms you use
                every day. See exactly what's inside.
              </p>
              <a class="home-text-link" href={`${APP_URL}/bags`}>
                Explore all bags <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="home-bag-grid">
            {featured.map((bag, index) => (
              <a
                class={`home-bag-card bag-tone-${index}`}
                href={`${APP_URL}/bag/${encodeURIComponent(bag.id)}`}
              >
                <div class="bag-artwork" aria-hidden="true">
                  <span class="bag-art-index">NB / 0{index + 1}</span>
                  <div class="bag-sculpture">
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                  <span class="bag-art-type">THEMATIC BAG</span>
                  <span class="bag-art-arrow">↗</span>
                </div>
                <div class="bag-card-content">
                  <div class="bag-card-meta">
                    <span>
                      {bag.issuer === "prestocks"
                        ? "PRE-IPO TOKENS"
                        : "TOKENIZED STOCKS"}
                    </span>
                    <span>{bag.assets.length} assets</span>
                  </div>
                  <h3>{bag.title}</h3>
                  <p>{bag.subtitle}</p>
                  <div class="bag-holdings">
                    {bag.assets.slice(0, 4).map((asset) => (
                      <span>{asset.symbol}</span>
                    ))}
                    {bag.assets.length > 4 && (
                      <span>+{bag.assets.length - 4}</span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
          <p class="catalogue-note">
            Composition shown for context, not a recommendation. Availability
            and liquidity vary.{" "}
            {catalogue.source === "static" &&
              "Illustrative catalogue; check the app for current holdings."}
          </p>
        </div>
      </section>

      <section
        id="trust"
        class="home-section home-container transparency-section"
      >
        <div class="transparency-intro">
          <p class="home-kicker">03 / NO BLACK BOX</p>
          <h2>
            Know what you're
            <br />
            getting into.
          </h2>
          <p>
            Good design shouldn't hide the details. From the source of a story
            to the tokens in your wallet, the important things stay in view.
          </p>
          <a class="home-text-link" href="/disclosures">
            Read the disclosures <span aria-hidden="true">↗</span>
          </a>
          <div class="transparency-stamp">
            <span aria-hidden="true">◎</span>
            <div>
              Built on Solana.
              <br />
              <strong>Built around your decision.</strong>
            </div>
          </div>
        </div>
        <div class="principles">
          <article>
            <span>01</span>
            <div>
              <h3>The evidence, not just the take.</h3>
              <p>
                Original sources, issuer information, and public filings are
                linked. AI-assisted story interpretations include uncertainty,
                not a promise of what happens next.
              </p>
            </div>
          </article>
          <article>
            <span>02</span>
            <div>
              <h3>Your wallet. Your authorization.</h3>
              <p>
                A Privy-secured wallet and Jupiter-powered swaps. Review amounts
                and transaction details before you authorize a trade.
              </p>
            </div>
          </article>
          <article>
            <span>03</span>
            <div>
              <h3>Different tokens. Different risks.</h3>
              <p>
                Tokenized stocks aren't direct share ownership. Pre-IPO tokens
                have additional issuer and liquidity risks. Congressional
                reports are delayed, not live signals.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section class="faq-section home-container">
        <div>
          <p class="home-kicker">A LITTLE MORE CONTEXT</p>
          <h2>
            Good questions.
            <br />
            Straight answers.
          </h2>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="home-container closing-section">
        <div class="closing-card">
          <div>
            <p class="home-kicker">YOUR NEXT PERSPECTIVE STARTS HERE</p>
            <h2>
              Read the world.
              <br />
              <span>Decide for yourself.</span>
            </h2>
            <p>The stories, the context, and the bags. All in one place.</p>
            <a class="home-button" href={APP_URL}>
              Explore Newsbid <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="closing-symbol" aria-hidden="true">
            n<span>↗</span>
          </div>
          <span class="closing-footnote">
            No investment advice. No guaranteed outcomes. Just more context.
          </span>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
