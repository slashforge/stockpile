---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Ticker from "../components/Ticker.astro";
import BagCard from "../components/BagCard.astro";
import Icon from "../components/app/Icon.astro";
import StoryReel from "../components/app/StoryReel.astro";
import ImpactCard from "../components/app/ImpactCard.astro";
import BagHoldings from "../components/app/BagHoldings.astro";
import TradeReview from "../components/app/TradeReview.astro";
import LogoCluster from "../components/app/LogoCluster.astro";
import { APP_URL, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { loadBagCatalogue, uniqueAssets } from "../lib/bags";
import { loadStories } from "../lib/stories";
import "../styles/home.css";

const catalogue = await loadBagCatalogue();
const bagsById = new Map(catalogue.bags.map((bag) => [bag.id, bag]));
const { stories, source: storySource } = await loadStories(catalogue.bags);

const heroStory = stories.find((s) => s.analysis.direction === "tailwind") ?? stories[0];
const heroBag = heroStory ? bagsById.get(heroStory.bagId) : undefined;
const feedStory = stories.find((s) => s !== heroStory && s.bagId !== heroStory?.bagId) ?? stories.find((s) => s !== heroStory) ?? heroStory;
const feedBag = feedStory ? bagsById.get(feedStory.bagId) : undefined;
const impactStory =
  stories.find((s) => s.analysis.direction === "headwind" && s !== feedStory && s !== heroStory) ??
  stories.find((s) => s !== feedStory && s !== heroStory) ??
  heroStory;
const impactBag = impactStory ? bagsById.get(impactStory.bagId) : undefined;
const tradeBag = bagsById.get("ai-infrastructure") ?? catalogue.bags.find((b) => b.tradable && b.assets.length > 2);

const themed = catalogue.bags.filter((b) => b.sourceType === "editorial");
const trackers = catalogue.bags.filter((b) => b.sourceType !== "editorial");
const tokenCount = uniqueAssets(catalogue.bags).length;
const closingAssets = uniqueAssets(themed).slice(0, 6);

const faqs = [
  [
    "What is a bag?",
    "A themed basket of tokens with a fixed allocation, like \"AI Infrastructure\" or \"Frontier AI Labs\". You see every holding, its weight, the sources behind it and the risks before you buy. A bag is not an ETF or a managed fund.",
  ],
  [
    "Am I buying actual shares?",
    "No. You buy tokens: xStocks track listed shares and PreStocks give exposure to private companies. Each issuer has its own structure, rights and restrictions. Read the issuer documentation and our disclosures.",
  ],
  [
    "How does a story connect to a bag?",
    "Each story is linked to the bags it touches. An AI model reads the publisher's excerpt and says which holdings it affects, the share of the bag they make up, and what is still uncertain. When there's no validated analysis, the app says so. It is never a forecast.",
  ],
  [
    "Who controls my wallet?",
    "You do. Your wallet is secured by Privy. Every swap is quoted by Jupiter on Solana and you approve each one. Newsbid never trades on your behalf.",
  ],
  [
    "What should I know before buying?",
    "You can lose everything you put in. Liquidity, prices, issuer restrictions and availability change. Pre-IPO tokens carry extra risk, and congressional disclosures are delayed reports, not live trades.",
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${SITE_TITLE} — Swipe the news. Buy the bag.`} description={SITE_DESCRIPTION} />
  </head>
  <body class="landing-home bg-background text-text antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <!-- Hero -->
      <section class="hero">
        <div class="hero__glow" aria-hidden="true"></div>
        <div class="container-x hero__grid">
          <div class="hero__copy">
            <span class="eyebrow-pill">
              <span class="rounded-full bg-brand-soft px-2 py-0.5 text-brand">On Solana</span>
              Tokenized stocks &amp; pre-IPO tokens
            </span>
            <h1>
              Swipe the news.
              <br />
              <span class="text-brand">Buy the bag.</span>
            </h1>
            <p class="hero__lead">
              Newsbid is a news feed where every story links to a <strong>bag</strong>: a themed basket of tokenized
              stocks and pre-IPO names. See which holdings a headline touches, look inside, and buy the whole basket in
              one slide.
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <a class="btn-pill btn-pill--solid" href={APP_URL}>
                Open Newsbid <Icon name="arrow" size={18} />
              </a>
              <a class="btn-pill btn-pill--outline" href="#how">See how it works</a>
            </div>
            <ul class="hero__facts">
              <li><span><Icon name="newspaper" size={14} /></span> Source on every story</li>
              <li><span><Icon name="layers" size={14} /></span> Every weight in view</li>
              <li><span><Icon name="wallet" size={14} /></span> Your wallet, your approval</li>
            </ul>
          </div>

          {heroStory && heroBag && (
            <div class="hero__stage">
              <div class="hero__phone">
                <StoryReel story={heroStory} bag={heroBag} />
              </div>
              <div class="hero__float hero__float--sheet">
                <BagHoldings bag={heroBag} limit={3} highlight={heroStory.analysis.affectedSymbols} />
              </div>
              <span class="hero__tag hero__tag--feed">The feed</span>
              <span class="hero__tag hero__tag--bag">The bag behind it</span>
            </div>
          )}
        </div>
      </section>

      <Ticker bags={catalogue.bags} />

      <!-- How it works -->
      <section id="how" class="container-x section-y">
        <div class="section-head">
          <span class="eyebrow-pill">How it works</span>
          <h2>From headline to holdings in three taps.</h2>
          <p>These are the real screens, filled with stories and bags from the app today.</p>
        </div>

        <div class="flow">
          {feedStory && feedBag && (
            <article class="flow-row">
              <div class="flow-row__visual flow-row__visual--narrow">
                <StoryReel story={feedStory} bag={feedBag} compact />
              </div>
              <div class="flow-row__copy">
                <span class="step-num">1</span>
                <h3>Swipe the story.</h3>
                <p>
                  The feed is one story per screen from publishers like CNBC, TechCrunch and Ars Technica, plus public
                  disclosures. Each card shows the publisher, the source link and the bag it relates to.
                </p>
                <ul class="checks">
                  <li><Icon name="check" size={16} /> Open the original article any time</li>
                  <li><Icon name="check" size={16} /> AI summaries are labeled as AI</li>
                  <li><Icon name="check" size={16} /> Swipe up on the bag bar to look inside</li>
                </ul>
              </div>
            </article>
          )}

          {impactStory && impactBag && (
            <article class="flow-row flow-row--flip">
              <div class="flow-row__visual flow-row__stack">
                <ImpactCard story={impactStory} bag={impactBag} />
                <BagHoldings bag={impactBag} limit={4} highlight={impactStory.analysis.affectedSymbols} class="flow-row__under" />
              </div>
              <div class="flow-row__copy">
                <span class="step-num">2</span>
                <h3>See what it touches.</h3>
                <p>
                  Every story says which holdings it's about and what share of the bag they make up. It flags a
                  potential <span class="text-positive font-semibold">tailwind</span> or
                  <span class="text-danger font-semibold">headwind</span> and says what's still uncertain.
                </p>
                <ul class="checks">
                  <li><Icon name="check" size={16} /> Exposure is the bag's allocation, not a price forecast</li>
                  <li><Icon name="check" size={16} /> No validated analysis? It says "Analysis unavailable"</li>
                  <li><Icon name="check" size={16} /> Weights, sources and risks for every bag</li>
                </ul>
              </div>
            </article>
          )}

          {tradeBag && (
            <article class="flow-row">
              <div class="flow-row__visual flow-row__visual--narrow">
                <TradeReview bag={tradeBag} />
              </div>
              <div class="flow-row__copy">
                <span class="step-num">3</span>
                <h3>Buy the bag in one slide.</h3>
                <p>
                  Pick an amount in USDC. Newsbid splits it by the bag's weights into one swap per token, routed by
                  Jupiter. Check each leg, then slide to buy.
                </p>
                <ul class="checks">
                  <li><Icon name="check" size={16} /> Price impact shown for every swap</li>
                  <li><Icon name="check" size={16} /> Tokens land in your own Privy wallet</li>
                  <li><Icon name="check" size={16} /> Sell the whole bag, or single tokens, later</li>
                </ul>
              </div>
            </article>
          )}
        </div>
      </section>

      <!-- Bags -->
      <section id="bags" class="bags-band section-y">
        <div class="container-x">
          <div class="section-head section-head--split">
            <div>
              <span class="eyebrow-pill">The bags</span>
              <h2>{catalogue.bags.length} bags. {tokenCount} tokens.</h2>
            </div>
            <div class="flex flex-col items-start gap-3">
              <p>
                Themed bags picked by our editors, plus trackers built from public records: Congress's STOCK Act filings
                and an Inverse Cramer bag built from Mad Money calls.
              </p>
              <a class="btn-pill btn-pill--outline" href={`${APP_URL}/bags`}>
                Browse all bags <Icon name="arrow-up-right" size={16} />
              </a>
            </div>
          </div>

          <h3 class="group-label"><span class="dot bg-brand"></span> Themes <span>{themed.length}</span></h3>
          <div class="bag-grid bag-grid--feature">
            {themed.map((bag) => (
              <a href={`${APP_URL}/bag/${encodeURIComponent(bag.id)}`} class="block rounded-[28px]" aria-label={`${bag.title}: ${bag.subtitle}`}>
                <BagCard bag={bag} />
              </a>
            ))}
          </div>

          {trackers.length > 0 && (
            <>
              <h3 class="group-label mt-12"><span class="dot bg-coral"></span> Trackers <span>{trackers.length}</span></h3>
              <div class="bag-grid">
                {trackers.map((bag) => (
                  <a href={`${APP_URL}/bag/${encodeURIComponent(bag.id)}`} class="block rounded-[28px]" aria-label={`${bag.title}: ${bag.subtitle}`}>
                    <BagCard bag={bag} />
                  </a>
                ))}
              </div>
            </>
          )}

          <p class="mt-8 text-center text-[13px] text-text-muted">
            {catalogue.source === "live" ? "Line-ups pulled from the Newsbid API" : "Line-ups from the latest snapshot"}{storySource === "live" ? " and stories from the live feed" : ""}.
            Shown for context, not as a recommendation. Prices and liquidity live in the app.
          </p>
        </div>
      </section>

      <!-- Trust -->
      <section id="trust" class="container-x section-y">
        <div class="section-head">
          <span class="eyebrow-pill">Know what you're buying</span>
          <h2>The details stay in view.</h2>
        </div>
        <div class="trust-grid">
          <article class="trust-card">
            <span class="trust-icon bg-brand-soft text-brand"><Icon name="document" size={20} /></span>
            <h3>Sources, not vibes</h3>
            <p>Every story links to its publisher. Every bag lists the sources and filings behind it.</p>
          </article>
          <article class="trust-card">
            <span class="trust-icon bg-tertiary-soft text-tertiary"><Icon name="sparkles" size={20} /></span>
            <h3>Honest AI</h3>
            <p>AI analysis is labeled, says what's uncertain, and goes quiet when it's stale. It never predicts prices.</p>
          </article>
          <article class="trust-card">
            <span class="trust-icon bg-mint-soft text-positive"><Icon name="wallet" size={20} /></span>
            <h3>Your keys, your call</h3>
            <p>A Privy-secured wallet and Jupiter swaps. You review and approve every transaction yourself.</p>
          </article>
          <article class="trust-card">
            <span class="trust-icon bg-caution-soft text-caution"><Icon name="shield" size={20} /></span>
            <h3>Risks up front</h3>
            <p>Tokens aren't shares. Pre-IPO tokens and thin pools carry more risk. Each bag says so before you buy.</p>
          </article>
        </div>
      </section>

      <!-- FAQ -->
      <section class="container-x section-y faq">
        <div>
          <span class="eyebrow-pill">FAQ</span>
          <h2>Straight answers.</h2>
          <p class="mt-3 text-text-subtle">
            More in the <a class="link" href="/disclosures">disclosures</a>.
          </p>
        </div>
        <div class="faq__list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Closing -->
      <section class="container-x pb-24">
        <div class="closing">
          <svg class="closing__motif" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <circle cx="368" cy="24" r="150" fill="#fff" fill-opacity="0.14"></circle>
            <circle cx="32" cy="228" r="90" fill="#fff" fill-opacity="0.12"></circle>
            <path d="M0 170 C 120 103, 240 228, 400 146 L 400 240 L 0 240 Z" fill="#fff" fill-opacity="0.1"></path>
          </svg>
          <div class="relative flex flex-col items-start gap-5">
            <LogoCluster assets={closingAssets} size={52} limit={6} />
            <h2>Read the news. Pick your bag.</h2>
            <p>Free to browse. Sign in with email when you're ready to buy.</p>
            <a class="btn-pill btn-pill--light" href={APP_URL}>
              Open Newsbid <Icon name="arrow" size={18} />
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
