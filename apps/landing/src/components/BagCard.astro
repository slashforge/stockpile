---
import TokenAvatar from './TokenAvatar.astro';
import { bagGradient, bagTradable, hash, type LandingBag } from '../lib/bags';

interface Props {
  bag: LandingBag;
  class?: string;
}

const { bag, class: className = '' } = Astro.props;
const [from, to] = bagGradient(bag);
const limit = 4;
const shown = bag.assets.length > limit ? bag.assets.slice(0, limit - 1) : bag.assets;
const rest = bag.assets.length - shown.length;
const tradable = bagTradable(bag);
const preIpo = bag.issuer === 'prestocks';
const seed = hash(bag.id);
const r1 = 130 + (seed % 5) * 14;
const r2 = 70 + (seed % 3) * 18;
const wave = 150 + (seed % 4) * 12;
const tokenCount = bag.assets.length
  ? `${bag.assets.length} ${bag.assets.length === 1 ? 'token' : 'tokens'}`
  : 'From STOCK Act filings';
---

<article class:list={['bag-card squircle', className]} style={`--from:${from}; --to:${to}`}>
  <svg class="bag-card__motif" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <circle cx="368" cy="24" r={r1} fill="#fff" fill-opacity="0.14"></circle>
    <circle cx="32" cy="228" r={r2} fill="#fff" fill-opacity="0.12"></circle>
    <path d={`M0 ${wave} C 120 ${wave - 67}, 240 ${wave + 58}, 400 ${wave - 24} L 400 240 L 0 240 Z`} fill="#fff" fill-opacity="0.1"></path>
    <circle cx="248" cy="48" r="3" fill="#fff" fill-opacity="0.6"></circle>
    <circle cx="280" cy="72" r="2" fill="#fff" fill-opacity="0.5"></circle>
    <circle cx="72" cy="60" r="2.5" fill="#fff" fill-opacity="0.45"></circle>
  </svg>
  <div class="bag-card__scrim" aria-hidden="true"></div>

  <div class="relative flex items-center pl-[3px]">
    {shown.length > 0 ? (
      <>
        {shown.map((a, i) => (
          <TokenAvatar
            symbol={a.symbol}
            name={a.name}
            iconUrl={a.iconUrl}
            brandColor={a.brandColor}
            size={48}
            index={i}
            ring
            class="-ml-3 first:ml-0"
            style={`z-index:${shown.length - i}`}
          />
        ))}
        {rest > 0 && (
          <span class="-ml-3 w-12 h-12 rounded-full bg-[#E9EDFF] text-brand font-extrabold text-[15px] grid place-items-center ring-[3px] ring-white shadow-md">
            +{rest}
          </span>
        )}
      </>
    ) : (
      <span class="w-12 h-12 rounded-full bg-white/25 text-white grid place-items-center ring-[3px] ring-white/60">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12h6m-6 4h6M7 4h7l5 5v11a1 1 0 01-1 1H7a1 1 0 01-1-1V5a1 1 0 011-1z" /></svg>
      </span>
    )}
  </div>

  <div class="relative mt-auto pt-8">
    <h3 class="text-[26px] leading-[31px] font-extrabold tracking-[-0.02em] text-white truncate">{bag.title}</h3>
    <p class="mt-0.5 text-sm text-white/90 line-clamp-1">{bag.subtitle}</p>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <span class="chip-on-art">
        {tradable ? (
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z" /></svg>
        ) : (
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 012-2h13v16H6a2 2 0 00-2 2V5zM4 19a2 2 0 012-2h13" /></svg>
        )}
        {tradable ? 'Open to buy' : 'Research only'}
      </span>
      {preIpo && (
        <span class="chip-on-art">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12M6 21h12M7 3c0 5 10 5 10 9s-10 4-10 9M17 3c0 5-10 5-10 9s10 4 10 9" /></svg>
          Pre-IPO
        </span>
      )}
      <span class="text-xs font-semibold text-white/90 ml-1">{tokenCount}</span>
    </div>
  </div>
</article>

<style>
  .bag-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 236px;
    padding: 20px 20px 18px;
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--from), var(--to));
    box-shadow: 0 10px 20px -6px rgba(27, 34, 80, 0.18);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s ease;
  }
  .bag-card:hover {
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: 0 24px 40px -12px rgba(27, 34, 80, 0.3);
  }
  .bag-card__motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bag-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 19, 31, 0) 35%, rgba(16, 19, 31, 0.28) 100%);
  }
  .chip-on-art {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.24);
    color: #fff;
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
  }
</style>
