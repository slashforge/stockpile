---
import TokenAvatar from './TokenAvatar.astro';
import { BAG_GRADIENTS, formatWeight, type LandingBag } from '../lib/bags';

interface Props {
  bag: LandingBag;
}

const { bag } = Astro.props;
const gradient = BAG_GRADIENTS[bag.id] ?? 'bg-grad-blue';
const issuerLabel = bag.issuer === 'xstocks' ? 'xStocks · public equity' : 'PreStocks · pre-IPO';
const curatorLabel =
  bag.curator.kind === 'person' ? 'Disclosures' : bag.curator.kind === 'aggregate' ? 'STOCK Act' : 'Editorial';
const evidenceTotal = bag.assets.reduce((sum, a) => sum + a.evidenceCount, 0);
const shown = bag.assets.slice(0, 4);
const extra = bag.assets.length - shown.length;
---

<article class="card squircle p-0 overflow-hidden flex flex-col hover-lift">
  <div class:list={['relative h-28 px-5 pt-4', gradient]}>
    <div class="absolute inset-0 opacity-40 mix-blend-soft-light" aria-hidden="true" style="background: radial-gradient(120px 80px at 90% 10%, #fff, transparent 70%);"></div>
    <div class="relative flex items-center justify-between">
      <span class="badge bg-white/85 text-text text-xs py-0.5">{curatorLabel}</span>
      {bag.tradable ? (
        <span class="badge bg-white/85 text-positive text-xs py-0.5">Tradable</span>
      ) : (
        <span class="badge bg-white/85 text-caution text-xs py-0.5">Research only</span>
      )}
    </div>
    <div class="absolute -bottom-5 left-5 flex -space-x-2.5">
      {shown.map((a, i) => (
        <TokenAvatar symbol={a.symbol} name={a.name} iconUrl={a.iconUrl} brandColor={a.brandColor} size={44} index={i} class="ring-[3px] ring-white shadow-md" />
      ))}
      {extra > 0 && (
        <span class="w-11 h-11 rounded-[30%] bg-surface-subtle ring-[3px] ring-white grid place-items-center text-xs font-bold text-text-subtle">+{extra}</span>
      )}
      {bag.assets.length === 0 && (
        <span class="h-11 px-3 rounded-[30%] bg-surface-subtle ring-[3px] ring-white grid place-items-center text-xs font-semibold text-text-muted">Computed from filings</span>
      )}
    </div>
  </div>

  <div class="px-5 pt-8 pb-5 flex flex-col flex-1">
    <h3 class="text-xl text-text">{bag.title}</h3>
    <p class="mt-1 text-sm text-text-subtle text-pretty">{bag.subtitle}</p>

    {bag.assets.length > 0 && (
      <ul class="mt-4 space-y-1.5" aria-label="Holdings and editorial weights">
        {bag.assets.map((a, i) => (
          <li class="flex items-center gap-2.5 text-sm">
            <span class="font-semibold text-text w-24 truncate">{a.symbol}</span>
            <span class="flex-1 h-1.5 rounded-full bg-surface-subtle overflow-hidden">
              <span class="block h-full rounded-full" style={`width:${a.weightBps / 100}%; background:${a.brandColor ?? '#2563EB'}`}></span>
            </span>
            <span class="font-mono text-xs text-text-muted w-9 text-right">{formatWeight(a.weightBps)}</span>
          </li>
        ))}
      </ul>
    )}

    {!bag.tradable && bag.tradableReason && (
      <p class="mt-3 text-xs text-caution bg-caution-soft rounded-lg px-3 py-2">{bag.tradableReason}</p>
    )}

    <div class="mt-auto pt-4 space-y-0.5 text-xs text-text-muted">
      <p>Curated by <span class="text-text-subtle font-medium">{bag.curator.name}</span></p>
      <p>{issuerLabel}{evidenceTotal > 0 ? ` · ${evidenceTotal} filing${evidenceTotal === 1 ? '' : 's'} cited` : ''}</p>
    </div>
  </div>
</article>
