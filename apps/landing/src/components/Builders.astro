---
import { GITHUB_URL } from '../consts';
---

<section id="builders" class="section pt-0">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl squircle bg-text text-white px-6 py-10 sm:px-10 sm:py-14">
      <div class="absolute inset-0 -z-0 opacity-60" aria-hidden="true">
        <div class="absolute -top-24 -right-16 w-80 h-80 rounded-full bg-brand blur-3xl"></div>
        <div class="absolute -bottom-28 left-10 w-80 h-80 rounded-full bg-sky blur-3xl opacity-60"></div>
      </div>

      <div class="relative grid md:grid-cols-[1.2fr_0.8fr] gap-8 items-center">
        <div>
          <p class="eyebrow text-white/60 mb-3">For builders</p>
          <h2 class="text-3xl sm:text-4xl text-white text-balance">Open, typed, and built in public.</h2>
          <p class="mt-4 text-white/75 text-pretty max-w-xl">
            Hono API with an OpenAPI spec and a generated SDK, Expo mobile app, Drizzle on Postgres, deployed with SST on
            Cloudflare. Built for the Stocklana and Solana Mobile hackathons.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="badge bg-white/10 text-white">Solana</span>
            <span class="badge bg-white/10 text-white">Jupiter</span>
            <span class="badge bg-white/10 text-white">Privy</span>
            <span class="badge bg-white/10 text-white">xStocks</span>
            <span class="badge bg-white/10 text-white">PreStocks</span>
            <span class="badge bg-white/10 text-white">Expo</span>
            <span class="badge bg-white/10 text-white">Cloudflare</span>
          </div>
        </div>
        <div class="flex md:justify-end">
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white text-text font-semibold rounded-xl squircle px-6 py-3.5 hover:bg-surface-subtle transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
