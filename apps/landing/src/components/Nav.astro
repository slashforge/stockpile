---
import { APP_URL, SITE_TITLE } from "../consts";
---

<header class="site-header">
  <nav class="site-navigation" aria-label="Primary">
    <a href="/" class="site-wordmark" aria-label={`${SITE_TITLE} home`}>
      <img src="/favicon.svg" alt="" width="29" height="29" />
      <span>{SITE_TITLE}</span>
    </a>
    <div class="site-links">
      <a href="/#how" class="desktop-link">
        How it works
      </a>
      <a href="/#bags" class="desktop-link">
        The bags
      </a>
      <a href="/#trust" class="wide-link">
        Trust
      </a>
      <a href="/blog" class="desktop-link">
        Journal
      </a>
    </div>
    <a href={APP_URL} class="nav-open">
      Open app <span aria-hidden="true">↗</span>
    </a>
    <details class="mobile-navigation">
      <summary aria-label="Navigation menu">
        <span></span>
        <span></span>
      </summary>
      <div>
        <a href="/#how">How it works</a>
        <a href="/#bags">The bags</a>
        <a href="/#trust">Trust</a>
        <a href="/blog">Journal</a>
      </div>
    </details>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: rgba(245, 246, 251, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid #e6e8f1;
  }
  .site-navigation {
    display: flex;
    align-items: center;
    gap: 25px;
    width: min(1180px, calc(100% - 40px));
    height: 72px;
    margin-inline: auto;
  }
  .site-wordmark {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #10131f;
  }
  .site-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    margin-inline: auto;
  }
  .site-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    color: #555c72;
  }
  .site-links a:hover {
    color: #2563eb;
  }
  .nav-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: #2563eb;
    box-shadow: 0 6px 12px rgba(37, 99, 235, 0.28);
    transition: background-color 0.15s;
  }
  .nav-open:hover {
    background: #1d4ed8;
  }
  .nav-open span {
    font-size: 16px;
    line-height: 1;
  }
  .mobile-navigation {
    display: none;
  }
  @media (max-width: 1100px) {
    .site-links {
      gap: 22px;
    }
  }
  @media (max-width: 800px) {
    .wide-link {
      display: none !important;
    }
    .site-links {
      gap: 20px;
    }
  }
  @media (max-width: 580px) {
    .site-navigation {
      height: 64px;
      gap: 14px;
    }
    .site-wordmark {
      font-size: 21px;
    }
    .site-wordmark img {
      width: 26px;
      height: 26px;
    }
    .site-links {
      display: none;
    }
    .nav-open {
      margin-left: auto;
      padding-inline: 14px;
    }
    .mobile-navigation {
      display: block;
    }
    .mobile-navigation summary {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 32px;
      min-height: 44px;
      cursor: pointer;
      list-style: none;
    }
    .mobile-navigation summary::-webkit-details-marker {
      display: none;
    }
    .mobile-navigation summary span {
      width: 20px;
      height: 1px;
      background: #10131f;
      margin-inline: auto;
    }
    .mobile-navigation > div {
      position: absolute;
      top: 64px;
      inset-inline: 0;
      padding: 12px 20px 20px;
      border-bottom: 1px solid #e6e8f1;
      background: #f5f6fb;
      box-shadow: 0 14px 20px #192e5010;
    }
    .mobile-navigation a {
      display: flex;
      align-items: center;
      min-height: 48px;
      color: #10131f;
      font-size: 15px;
      font-weight: 600;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>
