---
import { APP_URL, SITE_TITLE } from "../consts";

const links = [
  { href: "/#front-page", label: "Front page" },
  { href: "/#how", label: "How it works" },
  { href: "/#bags", label: "Bags" },
  { href: "/#trust", label: "Trust", wide: true },
  { href: "/blog", label: "Journal" },
];
---

<header class="site-header" data-header>
  <nav class="site-navigation" aria-label="Primary">
    <a href="/" class="site-wordmark" aria-label={`${SITE_TITLE} home`}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>{SITE_TITLE}</span>
    </a>
    <div class="site-links">
      {links.map((link) => (
        <a href={link.href} class:list={[link.wide && "wide-link"]}>{link.label}</a>
      ))}
    </div>
    <a href={APP_URL} class="nav-open">
      Open app
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
    </a>
    <details class="mobile-navigation">
      <summary aria-label="Navigation menu">
        <span></span>
        <span></span>
      </summary>
      <div>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </details>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: rgba(243, 241, 236, 0.82);
    backdrop-filter: saturate(1.4) blur(18px);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .site-header.is-scrolled {
    border-bottom-color: rgba(16, 19, 31, 0.14);
  }
  .site-navigation {
    display: flex;
    align-items: center;
    gap: 24px;
    width: min(1240px, calc(100% - 48px));
    height: 72px;
    margin-inline: auto;
  }
  .site-wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Newsreader", Georgia, serif;
    font-size: 26px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #10131f;
  }
  .site-wordmark img {
    border-radius: 8px;
  }
  .site-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin-inline: auto;
  }
  .site-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    color: #4d5468;
    transition: color 0.15s;
  }
  .site-links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s;
  }
  .site-links a:hover {
    color: #10131f;
  }
  .site-links a:hover::after {
    transform: scaleX(1);
  }
  .nav-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: #0c0f19;
    transition: background-color 0.15s;
  }
  .nav-open:hover {
    background: #2563eb;
  }
  .mobile-navigation {
    display: none;
  }
  @media (max-width: 1100px) {
    .site-links {
      gap: 24px;
    }
  }
  @media (max-width: 860px) {
    .wide-link {
      display: none !important;
    }
    .site-links {
      gap: 20px;
    }
  }
  @media (max-width: 720px) {
    .site-navigation {
      width: calc(100% - 32px);
      height: 64px;
      gap: 12px;
    }
    .site-wordmark {
      font-size: 24px;
    }
    .site-wordmark img {
      width: 26px;
      height: 26px;
    }
    .site-links {
      display: none;
    }
    .nav-open {
      margin-left: auto;
      padding-inline: 14px;
    }
    .mobile-navigation {
      display: block;
    }
    .mobile-navigation summary {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 36px;
      min-height: 44px;
      cursor: pointer;
      list-style: none;
    }
    .mobile-navigation summary::-webkit-details-marker {
      display: none;
    }
    .mobile-navigation summary span {
      width: 20px;
      height: 1.5px;
      background: #10131f;
      margin-inline: auto;
      transition: transform 0.2s;
    }
    .mobile-navigation[open] summary span:first-child {
      transform: translateY(3.75px) rotate(45deg);
    }
    .mobile-navigation[open] summary span:last-child {
      transform: translateY(-3.75px) rotate(-45deg);
    }
    .mobile-navigation > div {
      position: absolute;
      top: 64px;
      inset-inline: 0;
      padding: 8px 16px 20px;
      border-bottom: 1px solid rgba(16, 19, 31, 0.14);
      background: #f3f1ec;
    }
    .mobile-navigation a {
      display: flex;
      align-items: center;
      min-height: 52px;
      border-bottom: 1px solid rgba(16, 19, 31, 0.1);
      color: #10131f;
      font-family: "Newsreader", Georgia, serif;
      font-size: 22px;
      font-weight: 500;
      letter-spacing: -0.01em;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const menu = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>
