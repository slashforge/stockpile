---
import { SITE_TITLE } from '../consts';
---

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="nav">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <img src="/logo.svg" alt="__NAME__ logo" class="w-8 h-8" />
      <span class="text-lg font-semibold text-text tracking-tight">{SITE_TITLE}</span>
    </a>

    <div class="flex items-center gap-6">
      <a href="/blog" class="text-text-subtle hover:text-text transition-colors duration-200 text-sm font-medium">
        Blog
      </a>
      <a
        href="#waitlist"
        class="btn-primary text-sm py-2.5 px-5"
      >
        Get Started
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    
    if (currentScroll > 50) {
      nav?.classList.add('bg-background/80', 'backdrop-blur-md', 'border-b', 'border-border-subtle');
    } else {
      nav?.classList.remove('bg-background/80', 'backdrop-blur-md', 'border-b', 'border-border-subtle');
    }
    
    lastScroll = currentScroll;
  });
</script>
