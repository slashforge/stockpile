---
import IPhone from '../IPhone.astro';
import Icon from '../app/Icon.astro';
import TokenAvatar from '../TokenAvatar.astro';
import { APP_URL } from '../../consts';
import { CHART_PALETTE, formatWeight, type LandingBag } from '../../lib/bags';

interface Props {
  bagCount: number;
  tokenCount: number;
  /** The bag shown in /screens/feed.webp, so the callout matches the screenshot. */
  featureBag?: LandingBag;
}

const { bagCount, tokenCount, featureBag } = Astro.props;
const longDate = { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' } as const;
const shortDate = { weekday: 'short', month: 'short', day: 'numeric' } as const;
const now = new Date();
const color = (bag: LandingBag, index: number) => bag.assets[index]?.brandColor ?? CHART_PALETTE[index % CHART_PALETTE.length];
---

<section class="hero">
  <div class="container-x">
    <div class="dateline reveal">
      <span>
        <span class="dateline__long" data-today="long">{now.toLocaleDateString('en-US', longDate)}</span>
        <span class="dateline__short" data-today="short">{now.toLocaleDateString('en-US', shortDate)}</span>
      </span>
      <span class="dateline__mid">The markets, by the story</span>
      <span>{bagCount} bags · {tokenCount} tokens<span class="dateline__chain"> · On Solana</span></span>
    </div>

    <div class="hero__grid">
      <div class="hero__copy">
        <span class="kicker kicker--brand kicker--rule reveal" style="--d:1">Tokenized stocks &amp; pre-IPO names</span>
        <h1 class="display hero__title reveal" style="--d:2">
          Swipe the news.
          <em>Buy the bag.</em>
        </h1>
        <p class="hero__lead reveal" style="--d:3">
          <span class="dropcap" aria-hidden="true">N</span><span class="sr-only">N</span>ewsbid is a news feed where every
          story is pinned to a <strong>bag</strong>: a themed basket of tokenized stocks and pre-IPO names. See which
          holdings a headline touches, look inside, and buy the whole basket in one slide.
        </p>
        <div class="hero__ctas reveal" style="--d:4">
          <a class="btn btn--ink" href={APP_URL}>Open Newsbid <Icon name="arrow" size={18} /></a>
          <a class="text-link" href="#how">See how it works</a>
        </div>
        <dl class="hero__facts reveal" style="--d:5">
          <div><dt>Sources</dt><dd>A link on every story</dd></div>
          <div><dt>Weights</dt><dd>Every holding in view</dd></div>
          <div><dt>Wallet</dt><dd>Yours. You approve.</dd></div>
        </dl>
      </div>

      <div class="hero__stage reveal" style="--d:3">
        <div class="hero__phone">
          <IPhone src="/screens/feed.webp" alt="The Newsbid feed: a CNBC story about Tesla pinned to the Consumer Frontiers bag" loading="eager" />
          <span class="note note--story" aria-hidden="true"><span>The story &amp; its source</span><i></i></span>
          <span class="note note--bag" aria-hidden="true"><span>The bag it touches</span><i></i></span>

          {featureBag && featureBag.assets.length > 0 && (
            <div class="clip" aria-label={`Inside ${featureBag.title}`}>
              <div class="clip__head">
                <span class="kicker">Inside the bag</span>
                <span class="clip__count">{featureBag.assets.length} tokens</span>
              </div>
              <p class="clip__title">{featureBag.title}</p>
              <div class="clip__bar" aria-hidden="true">
                {featureBag.assets.map((asset, index) => <span style={`flex:${asset.weightBps}; background:${color(featureBag, index)}`}></span>)}
              </div>
              <ul>
                {featureBag.assets.slice(0, 3).map((asset, index) => (
                  <li>
                    <TokenAvatar symbol={asset.symbol} name={asset.name} iconUrl={asset.iconUrl} brandColor={asset.brandColor} size={26} index={index} />
                    <span class="clip__sym">{asset.symbol}</span>
                    <span class="clip__w">{formatWeight(asset.weightBps)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The page is prerendered; keep the dateline on today's date.
  const now = new Date();
  document.querySelectorAll<HTMLElement>('[data-today]').forEach((el) => {
    el.textContent =
      el.dataset.today === 'short'
        ? now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
        : now.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
  });
</script>

<style>
  .hero {
    position: relative;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  .dateline {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    border-top: 3px double #10131f;
    border-bottom: 1px solid #10131f;
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .dateline > :last-child {
    text-align: right;
  }
  .dateline__short {
    display: none;
  }
  .dateline__mid {
    font-family: var(--serif);
    font-size: 15px;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    padding-top: 64px;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .hero__title {
    font-size: clamp(58px, 7.8vw, 112px);
    color: var(--text);
  }
  .hero__title em {
    display: block;
    color: var(--brand);
  }
  .hero__lead {
    max-width: 560px;
    font-family: var(--serif);
    font-size: 21px;
    line-height: 31px;
    color: var(--text-subtle);
    text-wrap: pretty;
  }
  .hero__lead strong {
    font-weight: 600;
    color: var(--text);
  }
  .dropcap {
    float: left;
    margin: 6px 10px -4px 0;
    font-family: var(--serif);
    font-size: 78px;
    line-height: 0.82;
    font-weight: 500;
    color: var(--text);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 580px;
    margin-top: 12px;
    border-top: 1px solid var(--rule);
  }
  .hero__facts div {
    padding: 14px 16px 0 0;
  }
  .hero__facts div + div {
    padding-left: 16px;
    border-left: 1px solid var(--rule);
  }
  .hero__facts dt {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero__facts dd {
    margin-top: 4px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--text);
  }

  /* Phone + margin notes */
  .hero__stage {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero__stage::before {
    content: '';
    position: absolute;
    inset: 6% -10% 4% 8%;
    z-index: -1;
    border-radius: 48px;
    background:
      radial-gradient(closest-side, rgba(37, 99, 235, 0.22), transparent),
      radial-gradient(60% 50% at 80% 90%, rgba(255, 122, 102, 0.16), transparent);
    filter: blur(20px);
  }
  .hero__phone {
    position: relative;
    width: min(320px, 72%);
    transform: rotate(2deg);
  }
  .note {
    position: absolute;
    right: 97%;
    display: flex;
    align-items: center;
    gap: 0;
    transform: rotate(-2deg);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    white-space: nowrap;
  }
  .note span {
    padding: 6px 10px;
    border: 1px solid #10131f;
    border-radius: 999px;
    background: var(--paper);
  }
  .note i {
    position: relative;
    width: 56px;
    height: 1px;
    background: #10131f;
  }
  .note i::after {
    content: '';
    position: absolute;
    right: -4px;
    top: -4px;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--brand);
    box-shadow: 0 0 0 3px #fff;
  }
  .note--story {
    top: 50%;
  }
  .note--bag {
    top: 81%;
  }

  .clip {
    position: absolute;
    left: 78%;
    top: 16%;
    width: 228px;
    padding: 16px;
    border: 1px solid #10131f;
    border-radius: 18px;
    background: #fff;
    box-shadow: 6px 6px 0 #10131f;
    transform: rotate(-3deg);
  }
  .clip__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .clip__head .kicker {
    font-size: 10px;
    color: var(--text-muted);
  }
  .clip__count {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .clip__title {
    margin-top: 6px;
    font-family: var(--serif);
    font-size: 22px;
    line-height: 26px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .clip__bar {
    display: flex;
    gap: 2px;
    height: 6px;
    margin: 12px 0 8px;
    overflow: hidden;
    border-radius: 3px;
  }
  .clip ul {
    display: flex;
    flex-direction: column;
  }
  .clip li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
  }
  .clip li + li {
    border-top: 1px solid #eef0f7;
  }
  .clip__sym {
    flex: 1;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .clip__w {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
  }

  @media (max-width: 1180px) {
    .clip {
      left: 64%;
      top: 4%;
    }
  }
  @media (max-width: 1023px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
      padding-top: 48px;
    }
    .hero__stage {
      padding-inline: 18%;
    }
    .hero__phone {
      width: min(320px, 100%);
    }
    .clip {
      left: 74%;
      top: 10%;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 80px;
      padding-bottom: 72px;
    }
    .dateline {
      grid-template-columns: auto auto;
      justify-content: space-between;
      font-size: 10.5px;
      white-space: nowrap;
    }
    .dateline__long,
    .dateline__chain,
    .dateline__mid {
      display: none;
    }
    .dateline__short {
      display: inline;
    }
    .hero__lead {
      font-size: 19px;
      line-height: 28px;
    }
    .dropcap {
      font-size: 66px;
    }
    .hero__facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__facts div,
    .hero__facts div + div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
    .hero__stage {
      padding-inline: 0;
      justify-content: flex-start;
    }
    .hero__phone {
      width: 62%;
      margin-left: 4%;
    }
    .note {
      display: none;
    }
    .clip {
      left: 64%;
      top: 18%;
      width: 176px;
      padding: 12px;
      box-shadow: 4px 4px 0 #10131f;
    }
    .clip__title {
      font-size: 18px;
      line-height: 22px;
    }
    .clip li:nth-child(3) {
      display: none;
    }
  }
</style>
