---
/** Real stories from the feed laid out as a newspaper front page, each with its bag pinned on. */
import PinnedBag from './PinnedBag.astro';
import Icon from '../app/Icon.astro';
import { type LandingBag } from '../../lib/bags';
import { storyDate, storyHost, type LandingStory } from '../../lib/stories';

interface Props {
  stories: LandingStory[];
  bags: LandingBag[];
  live: boolean;
}

const { stories, bags, live } = Astro.props;
const byId = new Map(bags.map((bag) => [bag.id, bag]));
const placed = stories
  .map((story) => ({ story, bag: byId.get(story.bagId) }))
  .filter((entry): entry is { story: LandingStory; bag: LandingBag } => !!entry.bag);
const lead = placed.find((entry) => entry.story.analysis.direction === 'tailwind') ?? placed[0];
const side = placed.filter((entry) => entry !== lead).slice(0, 3);
---

{lead && (
  <section id="front-page" class="section-y">
    <div class="container-x">
      <header class="section-head" data-reveal>
        <div>
          <span class="kicker kicker--brand kicker--rule">{live ? 'Today on Newsbid' : 'From a recent edition'}</span>
          <h2 class="section-title">Every headline, <em>pinned to a bag.</em></h2>
        </div>
        <p class="section-lead">
          These are real stories from the feed. For each one, an AI model reads the publisher's excerpt and notes which
          holdings it touches, how much of the bag they make up, and what is still uncertain.
        </p>
      </header>

      <div class:list={['fp', side.length === 0 && 'fp--solo']}>
        <article class="fp__lead" data-reveal>
          <div class="fp__meta">
            <span class="fp__pub">{lead.story.publisher}</span>
            {storyDate(lead.story.publishedAt) && <span>{storyDate(lead.story.publishedAt)}</span>}
            {lead.story.provenance === 'ai' && <span class="fp__ai"><Icon name="sparkles" size={12} /> AI summary</span>}
          </div>
          {lead.story.imageUrl && (
            <div class="fp__photo">
              <img src={lead.story.imageUrl} alt="" referrerpolicy="no-referrer" loading="lazy" decoding="async" onerror="this.parentElement.remove()" />
            </div>
          )}
          <h3 class="fp__headline fp__headline--lead">{lead.story.title}</h3>
          <p class="fp__summary">{lead.story.summary}</p>
          <a class="fp__source" href={lead.story.sourceUrl} target="_blank" rel="noreferrer">
            Read at {storyHost(lead.story.sourceUrl)} <Icon name="arrow-up-right" size={14} />
          </a>
          <div class="fp__pin">
            <PinnedBag story={lead.story} bag={lead.bag} detailed />
          </div>
        </article>

        {side.length > 0 && (
          <div class="fp__side">
            {side.map(({ story, bag }, index) => (
              <article class="fp__item" data-reveal style={`--d:${index + 1}`}>
                <div class="fp__meta">
                  <span class="fp__pub">{story.publisher}</span>
                  {storyDate(story.publishedAt) && <span>{storyDate(story.publishedAt)}</span>}
                </div>
                <h3 class="fp__headline">{story.title}</h3>
                <a class="fp__source" href={story.sourceUrl} target="_blank" rel="noreferrer">
                  Read at {storyHost(story.sourceUrl)} <Icon name="arrow-up-right" size={14} />
                </a>
                <div class="fp__pin">
                  <PinnedBag story={story} bag={bag} />
                </div>
              </article>
            ))}
          </div>
        )}
      </div>

      <p class="fp__foot">
        AI analysis of each publisher's excerpt. Exposure is the bag's allocation, not a price forecast or investment
        advice. When there's no validated analysis, the app says so.
      </p>
    </div>
  </section>
)}

<style>
  .fp {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--rule);
  }
  .fp--solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .fp__lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: 40px 48px 48px 0;
  }
  .fp--solo .fp__lead {
    max-width: 820px;
  }
  .fp__side {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--rule);
  }
  .fp__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 40px 0 44px 48px;
  }
  .fp__item + .fp__item {
    border-top: 1px solid var(--rule);
  }
  .fp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .fp__pub {
    color: var(--text);
  }
  .fp__ai {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--brand);
  }
  .fp__photo {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    background: var(--paper-deep);
  }
  .fp__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fp__headline {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 34px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }
  .fp__headline--lead {
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .fp__summary {
    max-width: 620px;
    font-family: var(--serif);
    font-size: 20px;
    line-height: 30px;
    color: var(--text-subtle);
    text-wrap: pretty;
  }
  .fp__source {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-subtle);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }
  .fp__source:hover {
    color: var(--brand);
    text-decoration-color: currentColor;
  }
  .fp__pin {
    width: 100%;
    max-width: 520px;
    margin-top: 14px;
  }
  .fp__foot {
    max-width: 640px;
    margin-top: 20px;
    font-size: 13px;
    line-height: 20px;
    color: var(--text-muted);
  }
  @media (max-width: 1023px) {
    .fp {
      grid-template-columns: minmax(0, 1fr);
    }
    .fp__lead {
      padding-right: 0;
    }
    .fp__side {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .fp__item {
      padding-left: 0;
    }
  }
  @media (max-width: 640px) {
    .fp__lead,
    .fp__item {
      padding-block: 32px;
    }
    .fp__summary {
      font-size: 18px;
      line-height: 27px;
    }
    .fp__headline {
      font-size: 26px;
      line-height: 30px;
    }
    .fp__headline--lead {
      font-size: 34px;
      line-height: 37px;
    }
  }
</style>
