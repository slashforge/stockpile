---
import Icon from '../app/Icon.astro';
import LogoCluster from '../app/LogoCluster.astro';
import { APP_URL } from '../../consts';
import type { LandingAsset } from '../../lib/bags';

interface Props {
  assets: LandingAsset[];
}

const { assets } = Astro.props;
---

<section class="container-x closing-wrap">
  <div class="closing" data-reveal>
    <div class="closing__grid" aria-hidden="true"></div>
    <div class="closing__body">
      <LogoCluster assets={assets} size={48} limit={6} />
      <h2 class="display">Read the news. <em>Pick your bag.</em></h2>
      <p>Free to browse. Sign in with email when you're ready to buy.</p>
      <div class="closing__ctas">
        <a class="btn btn--white" href={APP_URL}>Open Newsbid <Icon name="arrow" size={18} /></a>
        <a class="closing__link" href="/disclosures">Read the disclosures</a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-wrap {
    padding-bottom: 120px;
  }
  .closing {
    position: relative;
    overflow: hidden;
    padding: 96px 64px;
    border-radius: 32px;
    background:
      radial-gradient(700px 400px at 90% 0%, rgba(56, 189, 248, 0.55), transparent 70%),
      radial-gradient(600px 400px at 0% 100%, rgba(12, 15, 25, 0.35), transparent 70%),
      var(--brand);
    color: #fff;
  }
  .closing__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 80% at 70% 30%, #000, transparent 75%);
  }
  .closing__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }
  .closing h2 {
    max-width: 900px;
    font-size: clamp(48px, 7vw, 104px);
  }
  .closing h2 em {
    display: block;
    color: #cfe2ff;
  }
  .closing p {
    font-size: 18px;
    line-height: 28px;
    color: rgba(255, 255, 255, 0.85);
  }
  .closing__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 28px;
  }
  .closing__link {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 5px;
  }
  .closing__link:hover {
    text-decoration-color: #fff;
  }
  @media (max-width: 640px) {
    .closing-wrap {
      padding-bottom: 72px;
    }
    .closing {
      padding: 64px 24px;
      border-radius: 24px;
    }
  }
</style>
