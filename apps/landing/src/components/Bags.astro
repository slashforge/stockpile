---
import BagCard from './BagCard.astro';
import type { BagCatalogue } from '../lib/bags';

interface Props {
  catalogue: BagCatalogue;
}

const { catalogue } = Astro.props;
const asOf = catalogue.fetchedAt
  ? new Date(catalogue.fetchedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<section id="bags" class="section bg-white border-y border-border">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Bags</p>
        <h2 class="text-4xl sm:text-5xl text-text text-balance">Eight bags. Every position has a receipt.</h2>
        <p class="mt-4 text-lg text-text-subtle text-pretty">
          Six editorial bags across tokenized megacaps and pre-IPO names, plus two built from STOCK Act filings.
          Weights are shown; prices and performance are not.
        </p>
      </div>
      <p class="text-sm text-text-muted md:text-right shrink-0">
        {catalogue.source === 'live' ? `Composition from the Stockpile API, ${asOf}` : 'Composition snapshot; live data in the app'}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {catalogue.bags.map((bag) => <BagCard bag={bag} />)}
    </div>

    <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-text-muted">
      <span class="inline-flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-brand"></span> xStocks: NVDAx, AAPLx, MSFTx, GOOGLx, AMZNx, METAx, TSLAx, NFLXx, AMDx, AVGOx, PLTRx, ORCLx, INTCx, COINx, HOODx, MSTRx, CRCLx, BACx, MCDx, WMTx, KOx, PGx, PEPx, SPYx, QQQx, GLDx</span>
      <span class="inline-flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-tertiary"></span> PreStocks: OpenAI, Anthropic, SpaceX, Kalshi, Polymarket, Anduril, Figure AI, Neuralink</span>
    </div>
  </div>
</section>
