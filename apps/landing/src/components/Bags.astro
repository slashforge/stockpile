---
import BagCard from './BagCard.astro';
import IPhone from './IPhone.astro';
import type { BagCatalogue } from '../lib/bags';

interface Props {
  catalogue: BagCatalogue;
}

const { catalogue } = Astro.props;
const editorial = catalogue.bags.filter((b) => b.sourceType === 'editorial');
const disclosure = catalogue.bags.filter((b) => b.sourceType === 'disclosure');
const ordered = [...editorial, ...disclosure];
---

<section id="bags" class="section relative overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-full -z-10 bg-white" aria-hidden="true"></div>
  <div class="absolute -z-10 top-24 -right-40 w-[520px] h-[520px] rounded-full bg-coral/10 blur-3xl" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center mb-14">
      <div data-reveal>
        <p class="pill-label">The bags</p>
        <h2 class="mt-4 text-4xl sm:text-[56px] sm:leading-[1.02] font-extrabold tracking-[-0.035em] text-text text-balance">
          A bag for every&nbsp;<span class="text-brand">rabbit hole</span>.
        </h2>
        <p class="mt-5 text-lg text-text-subtle max-w-xl text-pretty">
          {catalogue.bags.length} hand-built baskets, from the megacaps everyone knows to pre-IPO names like OpenAI and SpaceX.
          Some are curated by our editors, some are built straight from Congress’s public trading filings.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="legend"><span class="w-2 h-2 rounded-full bg-brand"></span> {editorial.length} editorial</span>
          <span class="legend"><span class="w-2 h-2 rounded-full bg-coral"></span> {disclosure.length} from public filings</span>
          <span class="legend"><span class="w-2 h-2 rounded-full bg-tertiary"></span> Pre-IPO included</span>
        </div>
      </div>
      <div class="hidden lg:flex justify-center" data-reveal style="--d:1">
        <div class="relative w-[250px] rotate-[4deg]">
          <IPhone src="/screens/bag-detail.webp" alt="AI Infrastructure bag detail with a one-month index chart" />
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {ordered.map((bag, i) => (
        <div data-reveal style={`--d:${i % 3}`}>
          <BagCard bag={bag} />
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-text-muted text-center">
      {catalogue.source === 'live' ? 'Bag line-ups pulled live from the Stockpile API.' : 'Bag line-ups as of the latest snapshot.'}
      Prices, charts and liquidity live in the app.
    </p>
  </div>
</section>

<style>
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #f5f6fb;
    font-size: 13px;
    font-weight: 600;
    color: #555c72;
  }
</style>
