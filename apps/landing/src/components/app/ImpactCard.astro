---
/** "Why it matters" panel from apps/web `ImpactBreakdown`, for one story and one bag. */
import ImpactChip from './ImpactChip.astro';
import TokenAvatar from '../TokenAvatar.astro';
import { formatWeight, type LandingBag } from '../../lib/bags';
import { storyHost, type LandingStory } from '../../lib/stories';

interface Props {
  story: LandingStory;
  bag: LandingBag;
  class?: string;
}

const { story, bag, class: className = '' } = Astro.props;
const holdings = bag.assets
  .filter((asset) => story.analysis.affectedSymbols.includes(asset.symbol))
  .sort((a, b) => b.weightBps - a.weightBps);
const exposure = holdings.reduce((sum, asset) => sum + asset.weightBps, 0);
const bar = story.analysis.direction === 'tailwind' ? 'bg-positive' : story.analysis.direction === 'headwind' ? 'bg-danger' : 'bg-text-muted/40';
const points = [
  ['For this bag', story.analysis.bagImplication],
  ['What is uncertain', story.analysis.uncertainty],
];
---

<div class:list={['flex flex-col gap-3 rounded-[28px] bg-white p-5 shadow-[0_10px_20px_rgba(27,34,80,0.08)]', className]}>
  <div class="flex items-center justify-between gap-3">
    <span class="text-[12px] leading-4 font-bold uppercase tracking-[0.6px] text-text-muted">Why it matters</span>
    <span class="text-[12px] text-text-muted truncate">{story.publisher} · {storyHost(story.sourceUrl)}</span>
  </div>
  <p class="text-[15px] leading-[21px] font-semibold text-text line-clamp-2">{story.title}</p>
  <div class="h-px bg-border"></div>
  <div class="flex flex-col gap-1.5">
    <ImpactChip direction={story.analysis.direction} />
    <p class="text-[16px] leading-[21px] font-semibold text-text">{story.analysis.headline}</p>
  </div>
  {holdings.length > 0 && (
    <div class="flex flex-col gap-1.5">
      <div class="flex h-2 overflow-hidden rounded-full bg-surface-subtle" aria-hidden="true">
        <div class:list={['h-full rounded-full', bar]} style={`width:${Math.max(3, exposure / 100)}%`}></div>
      </div>
      <div class="flex flex-wrap items-center gap-1.5">
        {holdings.slice(0, 4).map((asset) => (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-subtle py-0.5 pl-0.5 pr-2 text-[12px] font-semibold tabular-nums">
            <TokenAvatar symbol={asset.symbol} iconUrl={asset.iconUrl} brandColor={asset.brandColor} size={20} />
            {asset.symbol} {formatWeight(asset.weightBps)}
          </span>
        ))}
        <span class="text-[12px] text-text-muted">of {bag.title}</span>
      </div>
    </div>
  )}
  <dl class="flex flex-col gap-2">
    {points.map(([label, text]) => (
      <div class="flex flex-col gap-0.5">
        <dt class="text-[12px] font-semibold uppercase tracking-[0.6px] text-text-muted">{label}</dt>
        <dd class="text-[13px] leading-[18px] text-text-subtle line-clamp-3">{text}</dd>
      </div>
    ))}
  </dl>
  <p class="text-[12px] leading-4 text-text-muted">
    AI analysis of the publisher's excerpt. Allocation share, not a price forecast or investment advice.
  </p>
</div>
