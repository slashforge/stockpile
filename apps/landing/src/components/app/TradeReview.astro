---
/** Buy review from the app's trade flow: amount, one swap per token, then slide to confirm. */
import Icon from './Icon.astro';
import TokenAvatar from '../TokenAvatar.astro';
import { formatWeight, type LandingBag } from '../../lib/bags';

interface Props {
  bag: LandingBag;
  amount?: number;
  limit?: number;
  class?: string;
}

const { bag, amount = 100, limit = 4, class: className = '' } = Astro.props;
const legs = bag.assets.slice(0, limit);
const rest = bag.assets.length - legs.length;
const usd = (bps: number) => `$${((amount * bps) / 10000).toFixed(2)}`;
---

<div class:list={['flex flex-col gap-3 rounded-[28px] bg-white p-5 shadow-[0_10px_20px_rgba(27,34,80,0.08)]', className]}>
  <div class="flex flex-col items-center gap-0.5 py-1">
    <span class="text-[12px] leading-4 font-bold uppercase tracking-[0.6px] text-text-muted">Put money in the bag</span>
    <span class="text-[44px] leading-[50px] font-extrabold tracking-[-1.2px] tabular-nums text-text">${amount}</span>
    <span class="text-[13px] text-text-subtle">USDC into {bag.title}</span>
  </div>
  <div class="overflow-hidden rounded-[20px] bg-background">
    {legs.map((asset, index) => (
      <div class:list={['flex items-center gap-2.5 px-4 py-[9px]', index > 0 && 'border-t border-border']}>
        <TokenAvatar symbol={asset.symbol} iconUrl={asset.iconUrl} brandColor={asset.brandColor} size={32} index={index} />
        <div class="flex min-w-0 flex-1 flex-col">
          <span class="text-[14px] leading-[19px] font-semibold text-text">{asset.symbol}</span>
          <span class="text-[12px] leading-4 text-text-muted truncate">{formatWeight(asset.weightBps)} of bag</span>
        </div>
        <span class="text-[15px] font-bold tabular-nums text-text">{usd(asset.weightBps)}</span>
      </div>
    ))}
    {rest > 0 && (
      <div class="border-t border-border px-4 py-2 text-[12px] font-semibold text-text-muted">+{rest} more swaps</div>
    )}
  </div>
  <div class="flex items-center gap-1.5 text-[12px] text-text-muted">
    <Icon name="shield" size={14} class="text-positive" />
    {bag.assets.length} swaps via Jupiter · you approve each one in your wallet
  </div>
  <div class="slide" aria-hidden="true">
    <span class="slide__fill"></span>
    <span class="slide__label">Slide to buy</span>
    <span class="slide__knob"><Icon name="chevron-right" size={22} /></span>
  </div>
</div>

<style>
  .slide {
    position: relative;
    display: flex;
    align-items: center;
    height: 58px;
    border-radius: 999px;
    background: #2563eb;
    box-shadow: 0 6px 12px rgba(37, 99, 235, 0.28);
    overflow: hidden;
  }
  .slide__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 58px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    animation: fill 3.2s cubic-bezier(0.6, 0, 0.2, 1) infinite;
  }
  .slide__label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
  }
  .slide__knob {
    position: absolute;
    left: 4px;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 999px;
    background: #fff;
    color: #2563eb;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.16);
    animation: knob 3.2s cubic-bezier(0.6, 0, 0.2, 1) infinite;
  }
  @keyframes knob {
    0%, 15% { transform: translateX(0); }
    55%, 70% { transform: translateX(26px); }
    100% { transform: translateX(0); }
  }
  @keyframes fill {
    0%, 15% { width: 58px; }
    55%, 70% { width: 84px; }
    100% { width: 58px; }
  }
</style>
