---
import { SITE_TITLE } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="py-12 px-6 bg-surface-dim border-t border-border-subtle">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <!-- Logo -->
      <div class="flex items-center gap-2.5">
        <img src="/logo.svg" alt="StackForge logo" class="w-7 h-7" />
        <span class="font-semibold text-text tracking-tight">{SITE_TITLE}</span>
      </div>

      <!-- Links -->
      <div class="flex flex-col items-center gap-3">
        <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
          <a href="/#features" class="text-text-subtle hover:text-text transition-colors">Features</a>
          <a href="/blog" class="text-text-subtle hover:text-text transition-colors">Blog</a>
          <a href="/privacy" class="text-text-subtle hover:text-text transition-colors">Privacy</a>
          <a href="/terms" class="text-text-subtle hover:text-text transition-colors">Terms</a>
        </div>
        <a 
          href="https://jup.ag/tokens/2AFzzF7EKDygNJ2VthGWNSftCthpSkTmqSg9p8bFsend" 
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-text-muted hover:text-text transition-colors font-mono"
        >2AFzzF7EKDygNJ2VthGWNSftCthpSkTmqSg9p8bFsend</a>
      </div>

      <!-- Social -->
      <div class="flex items-center gap-2">
        <a 
          href="https://x.com/stackforge" 
          target="_blank"
          rel="noopener noreferrer"
          class="w-9 h-9 rounded-full bg-surface-subtle flex items-center justify-center text-text-muted hover:text-text hover:bg-surface-hover transition-all"
          aria-label="Twitter"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a 
          href="https://t.me/stackforge" 
          target="_blank"
          rel="noopener noreferrer"
          class="w-9 h-9 rounded-full bg-surface-subtle flex items-center justify-center text-text-muted hover:text-text hover:bg-surface-hover transition-all"
          aria-label="Telegram"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        </a>
        <a 
          href="https://jup.ag/tokens/2AFzzF7EKDygNJ2VthGWNSftCthpSkTmqSg9p8bFsend" 
          target="_blank"
          rel="noopener noreferrer"
          class="w-9 h-9 rounded-full bg-surface-subtle flex items-center justify-center text-text-muted hover:text-text hover:bg-surface-hover transition-all"
          aria-label="Token"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.41 16.09V20h-2.67v-1.93c-1.71-.36-3.16-1.46-3.27-3.4h1.96c.1 1.05.82 1.87 2.65 1.87 1.96 0 2.4-.98 2.4-1.59 0-.83-.44-1.61-2.67-2.14-2.48-.6-4.18-1.62-4.18-3.67 0-1.72 1.39-2.84 3.11-3.21V4h2.67v1.95c1.86.45 2.79 1.86 2.85 3.39H14.3c-.05-1.11-.64-1.87-2.22-1.87-1.5 0-2.4.68-2.4 1.64 0 .84.65 1.39 2.67 1.91s4.18 1.39 4.18 3.91c-.01 1.83-1.38 2.83-3.12 3.16z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-border-subtle text-center">
      <p class="text-text-muted text-sm">
        &copy; {currentYear} {SITE_TITLE}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
