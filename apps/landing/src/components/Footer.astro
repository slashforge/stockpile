---
import { GITHUB_URL, SITE_TITLE } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-border rounded-t-[36px] sm:rounded-t-[44px]">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 py-12">
    <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-10 items-start">
      <div class="max-w-md">
        <div class="flex items-center gap-2.5 mb-5">
          <span class="w-8 h-8 rounded-full bg-grad-blue grid place-items-center">
            <img src="/logo-mark.svg" alt="" class="w-4 h-4" width="16" height="16" />
          </span>
          <span class="font-bold text-text tracking-tight">{SITE_TITLE}</span>
        </div>
        <p class="text-sm text-text-subtle text-pretty">
          Not investment advice. Tokenized stocks and pre-IPO tokens are high-risk and you can lose everything you put in.
          <a href="/disclosures" class="font-semibold text-brand hover:text-brand-hover">Read the disclosures</a>.
        </p>
      </div>

      <nav class="flex flex-wrap md:justify-end gap-x-6 gap-y-3 text-sm md:pt-1.5" aria-label="Footer">
        <a href="/#how" class="text-text-subtle hover:text-text transition-colors">How it works</a>
        <a href="/#bags" class="text-text-subtle hover:text-text transition-colors">Bags</a>
        <a href="/#trust" class="text-text-subtle hover:text-text transition-colors">Safety</a>
        <a href="/blog" class="text-text-subtle hover:text-text transition-colors">Blog</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-text transition-colors">GitHub</a>
        <a href="https://xstocks.fi/products" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-text transition-colors">xStocks</a>
        <a href="https://prestocks.com" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-text transition-colors">PreStocks</a>
      </nav>
    </div>

    <div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-text-muted">
      <p>&copy; {currentYear} {SITE_TITLE}. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="/disclosures" class="hover:text-text transition-colors">Disclosures</a>
        <a href="/privacy" class="hover:text-text transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-text transition-colors">Terms</a>
      </div>
      <p>Built for Solana Seeker · stockpile.cash</p>
    </div>
  </div>
</footer>
