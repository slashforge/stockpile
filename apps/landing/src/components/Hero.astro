---
import IPhone from './IPhone.astro';
import StoreBadges from './StoreBadges.astro';
import type { LandingBag } from '../lib/bags';

interface Props {
  bag: LandingBag;
}
---

<section id="get" class="relative overflow-hidden pt-28 sm:pt-32 lg:pt-36 pb-10 lg:pb-20">
  <div class="hero-bg" aria-hidden="true">
    <div class="blob bg-brand/25 w-[560px] h-[560px] -top-40 -left-40"></div>
    <div class="blob bg-sky/30 w-[620px] h-[620px] -top-20 right-[-200px]"></div>
    <div class="blob bg-coral/25 w-[460px] h-[460px] bottom-[-160px] left-[30%]"></div>
    <div class="blob bg-mint/20 w-[380px] h-[380px] bottom-10 right-[10%]"></div>
    <div class="dots"></div>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="grid lg:grid-cols-[1.08fr_1fr] gap-10 lg:gap-4 items-center">
      <div class="text-center lg:text-left relative z-10">
        <a
          href="#how"
          class="reveal inline-flex items-center gap-2 rounded-full bg-white/80 backdrop-blur border border-white pl-1.5 pr-3.5 py-1.5 text-sm font-semibold text-text-subtle shadow-sm hover:text-text transition"
        >
          <span class="rounded-full bg-brand-soft text-brand px-2.5 py-0.5 text-xs font-bold">New</span>
          Stocks &amp; pre-IPO, on Solana
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </a>

        <h1 class="reveal mt-6 text-[52px] leading-[0.98] sm:text-7xl lg:text-[62px] xl:text-[68px] font-extrabold tracking-[-0.045em] text-text text-balance" style="--d:1">
          Swipe the news.
          <span class="block">
            Buy the
            <span class="bag-word">
              <span class="bag-word__text">bag</span>
              <svg class="bag-word__squiggle" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 C 40 4, 70 18, 105 9 S 170 4, 197 11" fill="none" stroke="url(#sq)" stroke-width="7" stroke-linecap="round" /><defs><linearGradient id="sq" x1="0" x2="1"><stop offset="0" stop-color="#FF8A6B" /><stop offset="1" stop-color="#FFC24B" /></linearGradient></defs></svg>
            </span>.
          </span>
        </h1>

        <p class="reveal mt-6 text-lg sm:text-xl text-text-subtle max-w-[34rem] lg:max-w-[30rem] xl:max-w-[34rem] mx-auto lg:mx-0 text-pretty" style="--d:2">
          Stockpile turns headlines into <strong class="text-text font-semibold">bags</strong>: little baskets of tokenized
          stocks and pre-IPO names. Read the story, peek inside, and buy the whole bag with a single slide.
        </p>

        <div class="reveal mt-8" style="--d:3">
          <StoreBadges align="start" />
        </div>

        <ul class="reveal mt-8 flex flex-wrap justify-center lg:justify-start gap-x-5 gap-y-2 text-sm font-semibold text-text-subtle" style="--d:4">
          <li class="inline-flex items-center gap-1.5"><span class="tick">✓</span> Your own wallet</li>
          <li class="inline-flex items-center gap-1.5"><span class="tick">✓</span> Built for Solana Seeker</li>
          <li class="inline-flex items-center gap-1.5"><span class="tick">✓</span> Receipts on every pick</li>
        </ul>
      </div>

      <div class="stage reveal" style="--d:2">
        <div class="phone phone--left"><IPhone src="/screens/bags.webp" alt="Stockpile Bags tab: themed bags like Megacap Builders and AI Infrastructure" loading="eager" /></div>
        <div class="phone phone--right"><IPhone src="/screens/bag-sheet.webp" alt="Inside the Consumer Frontiers bag: Amazon, Tesla, Meta, Netflix and more with weights" loading="eager" /></div>
        <div class="phone phone--center"><IPhone src="/screens/feed.webp" alt="Stockpile feed: a news story about Tesla linked to the Consumer Frontiers bag" loading="eager" /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 999px;
    filter: blur(80px);
  }
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(16, 19, 31, 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
  }

  .bag-word {
    position: relative;
    display: inline-block;
    padding-right: 0.04em;
  }
  .bag-word__text {
    position: relative;
    z-index: 1;
    color: #2563eb;
    background: linear-gradient(100deg, #2563eb 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .bag-word__squiggle {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: -0.2em;
    width: 104%;
    height: 0.24em;
  }
  .bag-word__squiggle path {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: draw 0.9s 0.7s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .tick {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #e3f8f1;
    color: #0b8a67;
    font-size: 11px;
    font-weight: 800;
  }

  /* Phone fan */
  .stage {
    position: relative;
    height: 560px;
    margin-inline: -20px;
  }
  .phone {
    position: absolute;
    top: 50%;
    left: 50%;
  }
  .phone--center {
    width: 262px;
    z-index: 3;
    transform: translate(-50%, -50%);
  }
  .phone--left,
  .phone--right {
    width: 220px;
    z-index: 1;
    opacity: 0.98;
  }
  .phone--left {
    transform: translate(calc(-50% - 150px), calc(-50% + 26px)) rotate(-9deg);
  }
  .phone--right {
    transform: translate(calc(-50% + 150px), calc(-50% + 26px)) rotate(9deg);
  }

  @media (min-width: 640px) {
    .stage {
      height: 640px;
    }
    .phone--center {
      width: 290px;
    }
    .phone--left,
    .phone--right {
      width: 246px;
    }
    .phone--left {
      transform: translate(calc(-50% - 190px), calc(-50% + 30px)) rotate(-9deg);
    }
    .phone--right {
      transform: translate(calc(-50% + 190px), calc(-50% + 30px)) rotate(9deg);
    }
  }
  @media (min-width: 1024px) {
    .stage {
      height: 600px;
      margin-inline: 0;
    }
    .phone--center {
      width: 250px;
    }
    .phone--left,
    .phone--right {
      width: 210px;
    }
    .phone--left {
      transform: translate(calc(-50% - 130px), calc(-50% + 26px)) rotate(-9deg);
    }
    .phone--right {
      transform: translate(calc(-50% + 130px), calc(-50% + 26px)) rotate(9deg);
    }
  }
  @media (min-width: 1280px) {
    .stage {
      height: 680px;
    }
    .phone--center {
      width: 290px;
    }
    .phone--left,
    .phone--right {
      width: 246px;
    }
    .phone--left {
      transform: translate(calc(-50% - 170px), calc(-50% + 30px)) rotate(-9deg);
    }
    .phone--right {
      transform: translate(calc(-50% + 170px), calc(-50% + 30px)) rotate(9deg);
    }
  }
</style>
