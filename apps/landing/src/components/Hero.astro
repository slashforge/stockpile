---
import PhoneMock from './PhoneMock.astro';
import StoreBadges from './StoreBadges.astro';
import type { LandingBag } from '../lib/bags';

interface Props {
  bag: LandingBag;
}

const { bag } = Astro.props;
---

<section id="get" class="relative overflow-hidden pt-28 md:pt-36 pb-16 md:pb-24">
  <!-- Soft gradient wash -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-32 -left-24 w-[520px] h-[520px] rounded-full bg-brand/15 blur-3xl"></div>
    <div class="absolute top-10 right-[-140px] w-[560px] h-[560px] rounded-full bg-sky/25 blur-3xl"></div>
    <div class="absolute bottom-[-200px] left-1/3 w-[520px] h-[520px] rounded-full bg-coral/15 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-[380px] h-[380px] rounded-full bg-mint/15 blur-3xl"></div>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-8 items-center">
      <div class="text-center lg:text-left">
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 mb-6 hero-animate" style="--delay: 0">
          <span class="badge badge-brand">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 1H7a2 2 0 0 0-2 2v18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm-5 20a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm5-4H7V4h10v13z"/></svg>
            Built for Solana Seeker
          </span>
          <span class="badge">iOS · Android · Solana</span>
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-text text-balance hero-animate" style="--delay: 1">
          Swipe the news.<br />
          <span class="gradient-text">Buy the bag.</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-text-subtle max-w-xl mx-auto lg:mx-0 text-pretty hero-animate" style="--delay: 2">
          A feed of real stories, each linked to a bag: a curated basket of tokenized stocks and pre-IPO tokens.
          Every holding shows its evidence. Buy the whole bag in one flow, from your own wallet.
        </p>

        <div class="mt-8 hero-animate" style="--delay: 3">
          <StoreBadges align="start" />
        </div>

        <p class="mt-6 text-sm text-text-muted max-w-lg mx-auto lg:mx-0 hero-animate" style="--delay: 4">
          Not investment advice. xStocks and PreStocks are issuer products with their own eligibility rules.
          <a href="#disclosures" class="link">Read the disclosures</a>.
        </p>
      </div>

      <div class="hero-animate" style="--delay: 2">
        <PhoneMock bag={bag} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-animate {
    opacity: 0;
    transform: translateY(16px);
    animation: hero-fade-in 0.7s ease-out forwards;
    animation-delay: calc(var(--delay) * 0.12s);
  }
  @keyframes hero-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
