# Stockpile mobile runtime config (copy to .env; Expo inlines EXPO_PUBLIC_* at bundle time).
# API base URL. Simulator: http://localhost:4040. Physical device: http://<your-LAN-IP>:4040.
EXPO_PUBLIC_API_URL=http://localhost:4040

# Privy app + mobile client IDs (Privy dashboard > App settings > Clients).
# Leave empty to run in browse-only mode: discovery works, sign-in/saves/portfolio/trading are disabled.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Solana RPC used by the Privy embedded wallet to submit user-signed swap transactions.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional build variant suffix for scheme/bundle id (dev|beta|prod). Leave empty for default.
EXPO_PUBLIC_ENV=
